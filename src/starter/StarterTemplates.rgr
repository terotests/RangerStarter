; SPDX-License-Identifier: MIT
;
; StarterTemplates -- the text of the files the tool writes.
;
; Templates are built as a LIST OF LINES and joined, not as one long string
; literal. Three reasons, and the first is the one that matters:
;
;   * A shell script is full of `"`, `$` and `\`. In a single Ranger literal each
;     of those needs escaping, the escaping is invisible in the source, and one
;     wrong backslash produces a template that compiles and generates a broken
;     file. A line list has one level of escaping and reads like the file it
;     produces.
;   * A template that depends on the configuration -- one `case` arm per chosen
;     target -- is a loop over a list, not string concatenation inside a literal.
;   * A diff of a template is a diff of lines.
;
; THE `rgr.js` WRAPPER IS NOT OPTIONAL and it is not a convenience. Ranger compilers
; through 3.5.1 print `Compilation FAILED` and exit **0**. Written the obvious
; way, `rgrc src/Main.rgr -o=Main.js && node build/Main.js` is satisfied by that
; zero, the previous build is still on disk, and node runs THAT: the edit looks
; applied and the test looks green when neither is true. Every generated script
; goes through the wrapper, which deletes the output first, reads the log as well
; as the exit status, and treats a missing output file as a failure.

Import "StarterTargets.rgr"
Import "StarterText.rgr"

class StarterTemplates {

    Constructor () {
    }

    sfn header:string (what:string) {
        def lines:[string]
        push lines ("# " + what)
        push lines "#"
        push lines "# Generated by ranger-starter. Do not edit: change ranger.project.json"
        push lines "# and run `npm run setup -- --apply`."
        return (StarterText.joinWith(lines "\n"))
    }

    ; `scripts/rgr.js` -- compile and run, and fail when the compile fails.
    ;
    ; NODE, NOT BASH, for two reasons that are both about the generated project
    ; rather than about taste:
    ;
    ;   * `write_file` cannot set an executable bit, so a generated `scripts/rgr`
    ;     shell script would have to be invoked as `bash scripts/rgr` -- and `bash`
    ;     is not on PATH in the shell npm uses on Windows.
    ;   * The project already requires node, because that is what the compiler is.
    ;     A node wrapper adds no requirement at all.
    ;
    ; It resolves the compiler directly rather than going through `npx`, which
    ; costs a process, needs a `.cmd` shim on Windows, and can reach the network.
    ;
    ; The extension table is generated from `StarterTargets`, so the wrapper and
    ; the tool cannot disagree about what `-l=kotlin` writes.
    sfn rgrWrapper:string (targets:StarterTargets) {
        def l:[string]
        push l "#!/usr/bin/env node"
        push l "// rgr -- compile a Ranger program and run it, and FAIL when the compile fails."
        push l "//"
        push l "// Generated by ranger-starter. Do not edit: change ranger.project.json and"
        push l "// run `npm run setup -- --apply`."
        push l "//"
        push l "// WHY THIS EXISTS. Ranger compilers through 3.5.1 print `Compilation FAILED`"
        push l "// and exit 0. Written the obvious way,"
        push l "//"
        push l "//     npx rgrc src/Main.rgr -o=Main.js && node build/Main.js"
        push l "//"
        push l "// the `&&` is satisfied by that zero, the PREVIOUS build is still on disk, and"
        push l "// node runs that one -- so the edit looks applied and the test looks green when"
        push l "// neither is true. Later compilers exit non-zero, and which one is installed"
        push l "// here is whatever `npm install` resolved. So, on either: the output is deleted"
        push l "// first, the log is read as well as the status, and a missing output is an error."
        push l "//"
        push l "//   node scripts/rgr.js run   <src.rgr> [args...]   compile to JavaScript and run"
        push l "//   node scripts/rgr.js build <src.rgr> [-l=<lang>] compile only"
        push l "//   node scripts/rgr.js check <src.rgr>             compile and report"
        push l "//"
        push l "// Anything after `--` goes to the compiler."
        push l "//"
        push l "// SPDX-License-Identifier: MIT"
        push l "'use strict';"
        push l "const fs = require('fs');"
        push l "const path = require('path');"
        push l "const { spawnSync } = require('child_process');"
        push l ""
        push l "// Generated from the compiler's own target list."
        push l "const EXT = {"
        for targets.list t:StarterTarget i {
            if ((t.isVariant()) == false) {
                push l ("  " + t.id + ": '" + t.ext + "',")
            }
        }
        push l "};"
        push l ""
        push l "function usage(code) {"
        push l "  console.error('usage: node scripts/rgr.js run|build|check <src.rgr> [-l=<lang>] [-d=<dir>] [-- compiler flags]');"
        push l "  process.exit(code);"
        push l "}"
        push l ""
        push l "const argv = process.argv.slice(2);"
        push l "const cmd = argv.shift();"
        push l "if (['run', 'build', 'check'].indexOf(cmd) < 0) usage(1);"
        push l "const src = argv.shift();"
        push l "if (!src) usage(1);"
        push l "if (!fs.existsSync(src)) { console.error('rgr: no such file: ' + src); process.exit(1); }"
        push l ""
        push l "let lang = 'es6';"
        push l "let outdir = 'build';"
        push l "const args = [];"
        push l "let passthru = [];"
        push l "while (argv.length) {"
        push l "  const a = argv.shift();"
        push l "  if (a === '--') { passthru = argv.slice(); break; }"
        push l "  if (a.startsWith('-l=')) { lang = a.slice(3); continue; }"
        push l "  if (a.startsWith('-d=')) { outdir = a.slice(3); continue; }"
        push l "  args.push(a);"
        push l "}"
        push l ""
        push l "const ext = EXT[lang];"
        push l "if (!ext) { console.error('rgr: unknown language ' + lang); process.exit(1); }"
        push l "const base = path.basename(src, '.rgr');"
        push l "const outFile = base + '.' + ext;"
        push l "const out = path.join(outdir, outFile);"
        push l "fs.mkdirSync(outdir, { recursive: true });"
        push l "fs.rmSync(out, { force: true });"
        push l ""
        push l "// The compiler is resolved from node_modules, so there is no npx process, no"
        push l "// .cmd shim to find on Windows, and no chance of reaching the network."
        push l "let rgrc;"
        push l "try {"
        push l "  rgrc = require.resolve('ranger-compiler/dist/rgrc.js');"
        push l "} catch (e) {"
        push l "  console.error('rgr: ranger-compiler is not installed. Run `npm install`.');"
        push l "  process.exit(1);"
        push l "}"
        push l ""
        push l "const compile = spawnSync("
        push l "  process.execPath,"
        push l "  [rgrc, src, '-l=' + lang, '-d=' + outdir, '-o=' + outFile].concat(passthru),"
        push l "  { encoding: 'utf8' }"
        push l ");"
        push l "const log = (compile.stdout || '') + (compile.stderr || '');"
        push l ""
        push l "// Three independent failure signals, because no single one is reliable across"
        push l "// compiler versions: the exit status, the word FAILED in the log, and a missing"
        push l "// output file."
        push l "const failed ="
        push l "  compile.status !== 0 ||"
        push l "  log.indexOf('Compilation FAILED') >= 0 ||"
        push l "  log.indexOf('[FAIL]') >= 0 ||"
        push l "  !fs.existsSync(out);"
        push l ""
        push l "if (failed) {"
        push l "  process.stderr.write(log);"
        push l "  console.error('rgr: ' + src + ' did not compile');"
        push l "  process.exit(1);"
        push l "}"
        push l ""
        push l "if (cmd === 'check') { console.log('rgr: ' + src + ' compiles (' + lang + ')'); process.exit(0); }"
        push l "if (cmd === 'build') { console.log('rgr: ' + out); process.exit(0); }"
        push l ""
        push l "const RUNNERS = { es6: [process.execPath, []], python: ['python3', []], go: ['go', ['run']] };"
        push l "const runner = RUNNERS[lang];"
        push l "if (!runner) {"
        push l "  console.error('rgr: cannot run ' + lang + ' here; the output is ' + out);"
        push l "  process.exit(1);"
        push l "}"
        push l "const run = spawnSync(runner[0], runner[1].concat([out], args), { stdio: 'inherit' });"
        push l "process.exit(run.status === null ? 1 : run.status);"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; `src/Main.rgr` for an application: the smallest program that proves the loop
    ; works, with the project's own name in it.
    sfn mainSeed:string (projectName:string className:string) {
        def l:[string]
        push l "; SPDX-License-Identifier: MIT"
        push l ";"
        push l ("; " + projectName + " -- the entry point.")
        push l ";"
        push l "; This file was written once, by ranger-starter, and is yours now: nothing"
        push l "; regenerates it. Run it with `npm start`."
        push l ";"
        push l "; The `doc { ... }` block on `hello` is the API documentation vocabulary the"
        push l "; compiler already parses. It must be on the SAME LINE as the closing brace --"
        push l "; a `doc` block on its own line binds to nothing. `npm run docs` renders it."
        push l ""
        push l ("class " + className + " {")
        push l ""
        push l "    def greeting:string \"\""
        push l ""
        push l "    Constructor (greeting:string) {"
        push l "        this.greeting = greeting"
        push l "    }"
        push l ""
        push l "    fn hello:string (who:string) {"
        push l "        return (greeting + \" \" + who)"
        push l "    } doc {"
        push l "        public"
        push l "        description \"Greets somebody by name.\""
        push l "        param who \"Who to greet. Do not restate the type: the compiler knows it.\""
        push l "        returns \"The greeting.\""
        push l "    }"
        push l ""
        push l "    sfn m@(main):void () {"
        push l ("        def app (new " + className + "(\"hello from\"))")
        push l ("        print (app.hello(\"" + projectName + "\"))")
        push l "    }"
        ; A class with a public member must itself be public, and the compiler says
        ; so rather than guessing. The tail goes on the class's closing brace, same
        ; rule as a method's.
        push l "} doc {"
        push l "    public"
        push l ("    description \"" + projectName + ".\"")
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The test seed. It EXITS NON-ZERO on a failure, which is the only property
    ; that makes it a test rather than a print.
    sfn testSeed:string (projectName:string className:string entryImport:string) {
        def l:[string]
        push l "; SPDX-License-Identifier: MIT"
        push l ";"
        push l ("; " + projectName + " -- `npm test`.")
        push l ";"
        push l "; It exits non-zero when an expectation fails, which is the part that matters:"
        push l "; a test that only prints is a test CI cannot fail on."
        push l ";"
        push l "; Yours to extend; nothing regenerates it."
        push l ""
        push l ("Import \"" + entryImport + "\"")
        push l ""
        push l ("class " + className + "Test {")
        push l ""
        push l "    def failures:int 0"
        push l ""
        push l "    Constructor () {"
        push l "    }"
        push l ""
        push l "    fn expect:void (label:string got:string want:string) {"
        push l "        if (got == want) {"
        push l "            print (\"  ok   \" + label)"
        push l "            return"
        push l "        }"
        push l "        failures = failures + 1"
        push l "        print (\"  FAIL \" + label)"
        push l "        print (\"    got:  \" + got)"
        push l "        print (\"    want: \" + want)"
        push l "    }"
        push l ""
        push l "    sfn m@(main):void () {"
        push l ("        def t (new " + className + "Test())")
        push l ("        def app (new " + className + "(\"hello from\"))")
        push l ("        t.expect(\"greeting\" (app.hello(\"" + projectName + "\")) \"hello from " + projectName + "\")")
        push l "        if (t.failures > 0) {"
        push l "            print ((to_string t.failures) + \" failed\")"
        push l "            exit 1"
        push l "        }"
        push l "        print \"all good\""
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; `.github/workflows/ci.yml`.
    ;
    ; It runs what a contributor runs, in the order a contributor runs it, and
    ; nothing else. A generated workflow that drifts from the local commands is
    ; worse than no workflow, because it fails for reasons nobody can reproduce.
    ;
    ; `npm install`, not `npm ci`: a freshly generated project has no lockfile
    ; until somebody commits one, and `npm ci` fails outright without it.
    sfn githubWorkflow:string (scriptNames:[string] docsCheck:boolean multiTarget:boolean) {
        def l:[string]
        push l "# Generated by ranger-starter. Do not edit: change ranger.project.json and"
        push l "# run `npm run setup -- --apply`."
        push l "name: ci"
        push l ""
        push l "on:"
        push l "  push:"
        push l "    branches: [main, master]"
        push l "  pull_request:"
        push l ""
        push l "jobs:"
        push l "  build:"
        push l "    runs-on: ubuntu-latest"
        push l "    steps:"
        push l "      - uses: actions/checkout@v4"
        push l "      - uses: actions/setup-node@v4"
        push l "        with:"
        push l "          node-version: '20'"
        push l ""
        push l "      # `npm install`, not `npm ci`: a generated project has no lockfile until"
        push l "      # somebody commits one, and `npm ci` refuses to run without it."
        push l "      - run: npm install"
        push l ""
        push l "      # The compiler is an npm dependency, so there is no toolchain to set up"
        push l "      # for the targets this only COMPILES."
        push l "      - name: test"
        push l "        run: npm test"
        for scriptNames name:string i {
            if (startsWith name "build:") {
                push l ("      - name: " + name)
                push l ("        run: npm run " + name)
            }
        }
        if docsCheck {
            push l "      - name: documentation is complete"
            push l "        run: npm run docs:check"
        }
        push l ""
        push l "      # Not a build step: it reports what this runner has, so a failure above"
        push l "      # can be read as \"the toolchain is missing\" rather than guessed at."
        push l "      - name: doctor"
        push l "        run: npm run doctor"
        if multiTarget {
            push l ""
            push l "      # More than one target is configured, and the targets disagree --"
            push l "      # `to_double` accepts a trailing space on JavaScript and Python and"
            push l "      # refuses it on Go. The build steps above compile each one; running the"
            push l "      # same test on more than one runtime is what would catch a DIFFERENT"
            push l "      # ANSWER, and it needs those runtimes installed here first."
        }
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; --- web -----------------------------------------------------------------
    ;
    ; Vite's root is `web/`, and the compiled Ranger module lands in
    ; `web/generated/` -- INSIDE that root. A module outside the root needs
    ; `server.fs.allow` to be served in dev, which is a configuration trap that
    ; produces a 403 nobody can read. `web/generated/` is gitignored instead.

    sfn viteConfig:string () {
        def l:[string]
        push l "// Generated by ranger-starter. Do not edit: change ranger.project.json and"
        push l "// run `npm run setup -- --apply`."
        push l "import { defineConfig } from \"vite\";"
        push l ""
        push l "export default defineConfig({"
        push l "  // The page and the compiled Ranger module both live here, so Vite can"
        push l "  // serve the module in dev without any fs.allow exception."
        push l "  root: \"web\","
        push l "  build: {"
        push l "    outDir: \"../build/web-dist\","
        push l "    emptyOutDir: true,"
        push l "  },"
        push l "});"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    sfn webIndexHtml:string (projectName:string) {
        def l:[string]
        push l "<!doctype html>"
        push l "<html lang=\"en\">"
        push l "  <head>"
        push l "    <meta charset=\"utf-8\" />"
        push l "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />"
        push l ("    <title>" + projectName + "</title>")
        push l "  </head>"
        push l "  <body>"
        push l "    <main id=\"app\"></main>"
        push l "    <script type=\"module\" src=\"./main.js\"></script>"
        push l "  </body>"
        push l "</html>"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The page's own script: where the browser meets the Ranger module. A seed,
    ; because everything about a page is the author's.
    sfn webMainJs:string (className:string moduleName:string) {
        def l:[string]
        push l "// Written once by ranger-starter, and yours now: nothing regenerates it."
        push l "//"
        push l ("// `generated/" + moduleName + ".js` is compiled from src/" + moduleName + ".rgr by")
        push l "// `npm run web:compile`, which `web:dev` and `web:build` run first. Do not"
        push l "// edit it, and do not commit it -- it is gitignored."
        push l ("import { " + className + " } from \"./generated/" + moduleName + ".js\";")
        push l ""
        push l ("const app = new " + className + "();")
        push l "document.querySelector(\"#app\").textContent = app.greeting();"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The web entry point. NO `main`: `-esm` exports the classes and still calls
    ; `main` at the bottom of the file, so a web module with one would run it on
    ; page load.
    sfn webSeed:string (projectName:string className:string) {
        def l:[string]
        push l "; SPDX-License-Identifier: MIT"
        push l ";"
        push l ("; " + projectName + " -- the web module.")
        push l ";"
        push l "; Compiled with `-esm`, so every class here is an ES module export the page"
        push l "; can import. There is deliberately no `main`: the compiler calls it at the"
        push l "; bottom of the emitted file, which in a browser means it would run on page"
        push l "; load, before the page has decided it wants anything."
        push l ";"
        push l "; This file was written once and is yours now; nothing regenerates it."
        push l ""
        push l ("class " + className + " {")
        push l ""
        push l "    Constructor () {"
        push l "    }"
        push l ""
        push l "    fn greeting:string () {"
        push l ("        return \"hello from " + projectName + ", compiled from Ranger\"")
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; --- android --------------------------------------------------------------
    ;
    ; A HOST SHELL, not an Android ecosystem. The shell owns the lifecycle and
    ; the UI; the Ranger module owns the logic, compiled to Kotlin and dropped
    ; into the app's source set. Generating a whole Gradle universe from here
    ; would be generating something nobody asked for and everybody would then
    ; have to maintain by hand.
    ;
    ; `-ktpackage` must agree with the host package or nothing resolves, so both
    ; come from one value in `ranger.project.json`.

    sfn androidSettingsGradle:string (projectName:string) {
        def l:[string]
        push l "// Generated by ranger-starter. Do not edit: change ranger.project.json."
        push l "pluginManagement {"
        push l "    repositories {"
        push l "        google()"
        push l "        mavenCentral()"
        push l "        gradlePluginPortal()"
        push l "    }"
        push l "}"
        push l "dependencyResolutionManagement {"
        push l "    repositories {"
        push l "        google()"
        push l "        mavenCentral()"
        push l "    }"
        push l "}"
        push l ""
        push l ("rootProject.name = \"" + projectName + "\"")
        push l "include(\":app\")"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    sfn androidRootGradle:string () {
        def l:[string]
        push l "// Generated by ranger-starter. Do not edit: change ranger.project.json."
        push l "plugins {"
        push l "    id(\"com.android.application\") version \"8.7.3\" apply false"
        push l "    id(\"org.jetbrains.kotlin.android\") version \"2.0.21\" apply false"
        push l "    id(\"org.jetbrains.kotlin.plugin.compose\") version \"2.0.21\" apply false"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The device types decide the minimum SDK and the extra dependencies. They are
    ; not separate builds: one app, with the features each form factor needs.
    sfn androidAppGradle:string (packageName:string devices:[string] moduleName:string) {
        def minSdk:int 24
        def wantsWear:boolean (StarterText.includes(devices "wear"))
        def wantsTv:boolean (StarterText.includes(devices "tv"))
        if wantsWear {
            ; Wear OS 3 is API 30, and a lower minimum simply will not install.
            minSdk = 30
        }
        def l:[string]
        push l "// Generated by ranger-starter. Do not edit: change ranger.project.json"
        push l "// and run `npm run setup -- --apply`."
        push l "plugins {"
        push l "    id(\"com.android.application\")"
        push l "    id(\"org.jetbrains.kotlin.android\")"
        push l "    id(\"org.jetbrains.kotlin.plugin.compose\")"
        push l "}"
        push l ""
        push l "android {"
        push l ("    namespace = \"" + packageName + "\"")
        push l "    compileSdk = 35"
        push l ""
        push l "    defaultConfig {"
        push l ("        applicationId = \"" + packageName + "\"")
        push l ("        minSdk = " + (to_string minSdk))
        push l "        targetSdk = 35"
        push l "        versionCode = 1"
        push l "        versionName = \"0.1.0\""
        push l "    }"
        push l ""
        push l "    // The Ranger module is compiled into this source set by"
        push l ("    // `npm run android:compile`. Do not edit `" + moduleName + ".kt` -- it is")
        push l "    // generated, and gitignored."
        push l "    sourceSets {"
        push l "        getByName(\"main\") {"
        push l "            kotlin.srcDirs(\"src/main/kotlin\", \"src/main/generated\")"
        push l "        }"
        push l "    }"
        push l ""
        push l "    buildFeatures { compose = true }"
        push l "    compileOptions {"
        push l "        sourceCompatibility = JavaVersion.VERSION_17"
        push l "        targetCompatibility = JavaVersion.VERSION_17"
        push l "    }"
        push l "    kotlinOptions { jvmTarget = \"17\" }"
        push l "}"
        push l ""
        push l "dependencies {"
        push l "    implementation(platform(\"androidx.compose:compose-bom:2024.10.01\"))"
        push l "    implementation(\"androidx.compose.ui:ui\")"
        push l "    implementation(\"androidx.compose.material3:material3\")"
        push l "    implementation(\"androidx.activity:activity-compose:1.9.3\")"
        if wantsTv {
            push l "    // TV: a Leanback launcher entry needs the androidx TV material set."
            push l "    implementation(\"androidx.tv:tv-material:1.0.0\")"
        }
        if wantsWear {
            push l "    // Wear: the watch has its own Compose material set."
            push l "    implementation(\"androidx.wear.compose:compose-material:1.4.0\")"
        }
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    sfn androidManifest:string (displayName:string devices:[string]) {
        def wantsWear:boolean (StarterText.includes(devices "wear"))
        def wantsTv:boolean (StarterText.includes(devices "tv"))
        def l:[string]
        push l "<?xml version=\"1.0\" encoding=\"utf-8\"?>"
        push l "<!-- Generated by ranger-starter. Do not edit: change ranger.project.json. -->"
        push l "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\">"
        if wantsTv {
            push l ""
            push l "    <!-- A TV has no touchscreen, and the Play Store filters on this. -->"
            push l "    <uses-feature android:name=\"android.hardware.touchscreen\" android:required=\"false\" />"
            push l "    <uses-feature android:name=\"android.software.leanback\" android:required=\"false\" />"
        }
        if wantsWear {
            push l ""
            push l "    <uses-feature android:name=\"android.hardware.type.watch\" />"
        }
        push l ""
        push l "    <application"
        push l ("        android:label=\"" + displayName + "\"")
        push l "        android:theme=\"@style/Theme.Material3.DayNight.NoActionBar\">"
        push l "        <activity"
        push l "            android:name=\".MainActivity\""
        push l "            android:exported=\"true\">"
        push l "            <intent-filter>"
        push l "                <action android:name=\"android.intent.action.MAIN\" />"
        push l "                <category android:name=\"android.intent.category.LAUNCHER\" />"
        if wantsTv {
            push l "                <!-- Without this the app does not appear on a TV at all. -->"
            push l "                <category android:name=\"android.intent.category.LEANBACK_LAUNCHER\" />"
        }
        push l "            </intent-filter>"
        push l "        </activity>"
        push l "    </application>"
        push l "</manifest>"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The host shell: lifecycle and UI, calling into the Ranger module. A seed --
    ; this is the app, and it is the author's.
    sfn androidMainActivity:string (packageName:string className:string) {
        def l:[string]
        push l ("package " + packageName)
        push l ""
        push l "// Written once by ranger-starter, and yours now: nothing regenerates it."
        push l "//"
        push l ("// `" + className + "` is compiled from the shared module into")
        push l "// `src/main/generated/` by `npm run android:compile`, which `android:build`"
        push l "// runs first. Do not edit the generated file, and do not commit it."
        push l ""
        push l "import android.os.Bundle"
        push l "import androidx.activity.ComponentActivity"
        push l "import androidx.activity.compose.setContent"
        push l "import androidx.compose.foundation.layout.Box"
        push l "import androidx.compose.foundation.layout.fillMaxSize"
        push l "import androidx.compose.material3.MaterialTheme"
        push l "import androidx.compose.material3.Surface"
        push l "import androidx.compose.material3.Text"
        push l "import androidx.compose.runtime.Composable"
        push l "import androidx.compose.ui.Alignment"
        push l "import androidx.compose.ui.Modifier"
        push l ""
        push l "class MainActivity : ComponentActivity() {"
        push l "    override fun onCreate(savedInstanceState: Bundle?) {"
        push l "        super.onCreate(savedInstanceState)"
        push l "        setContent { MaterialTheme { AppScreen() } }"
        push l "    }"
        push l "}"
        push l ""
        push l "@Composable"
        push l "fun AppScreen() {"
        push l "    // The one line that crosses the seam: everything above is the host, and"
        push l "    // everything the greeting knows is Ranger."
        push l ("    val model = " + className + "()")
        push l "    Surface(modifier = Modifier.fillMaxSize()) {"
        push l "        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {"
        push l "            Text(text = model.greeting(), style = MaterialTheme.typography.headlineSmall)"
        push l "        }"
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; --- ios ------------------------------------------------------------------
    ;
    ; The same shape as Android, over `lib/apple` -- which ships inside
    ; `ranger-compiler`, so a generated project imports it with no dependency to
    ; declare. There is no `.xcodeproj` and no `xcodebuild`: `swiftc` builds an
    ; iOS executable directly and everything above it is bookkeeping a program
    ; can do instead.

    sfn iosAppSwift:string (projectName:string className:string appStructName:string) {
        def l:[string]
        push l "// Written once by ranger-starter, and yours now: nothing regenerates it."
        push l "//"
        push l ("// `" + className + "` is compiled from the shared module into `build/ios/` by")
        push l "// `npm run ios:compile`, which `ios:build` runs first. Do not edit the"
        push l "// generated file, and do not commit it."
        push l ""
        push l "import SwiftUI"
        push l ""
        push l "@main"
        push l ("struct " + appStructName + "App: App {")
        push l "    var body: some Scene {"
        push l "        WindowGroup {"
        push l "            ContentView()"
        push l "        }"
        push l "    }"
        push l "}"
        push l ""
        push l "struct ContentView: View {"
        push l "    // The one line that crosses the seam."
        push l ("    private let model = " + className + "()")
        push l ""
        push l "    var body: some View {"
        push l "        Text(model.greeting())"
        push l "            .font(.title2)"
        push l "            .padding()"
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The build, as a Ranger program over `lib/apple`.
    ;
    ; `--dry-run` is the reason this is worth generating rather than scripting in
    ; bash: `lib/Shell.rgr` records every command line and runs nothing, so the
    ; DECISIONS -- which SDK, which triple, which signing identity, in which
    ; order -- can be checked on a machine that is not a Mac. Which is most of
    ; them, most of the time.
    sfn iosBuildScript:string (projectName:string className:string bundleId:string devices:[string]) {
        def families:[string]
        if (StarterText.includes(devices "iphone")) {
            push families "(AppleDeviceFamily.iphone())"
        }
        if (StarterText.includes(devices "ipad")) {
            push families "(AppleDeviceFamily.ipad())"
        }
        if ((array_length families) == 0) {
            push families "(AppleDeviceFamily.iphone())"
        }

        def l:[string]
        push l "; SPDX-License-Identifier: MIT"
        push l ";"
        push l ("; " + projectName + " -- the iOS build, as a Ranger program.")
        push l ";"
        push l "; Generated by ranger-starter. Do not edit: change ranger.project.json and"
        push l "; run `npm run setup -- --apply`."
        push l ";"
        push l "; `lib/apple` ships inside `ranger-compiler`, so there is nothing to install"
        push l "; and nothing to declare. It drives xcrun, swiftc, plutil, codesign and simctl"
        push l "; directly: no .xcodeproj, no xcodebuild."
        push l ";"
        push l ";   node scripts/rgr.js run scripts/ios-build.rgr --dry-run"
        push l ";"
        push l "; prints every command the build WOULD run, and works on Linux. That is how"
        push l "; this file is tested on a machine that is not a Mac."
        push l ""
        push l "Import \"lib/apple/AppleAppBuilder.rgr\""
        push l ""
        push l "class IosBuild {"
        push l ""
        push l "    sfn spec:AppleAppSpec () {"
        push l "        def s (new AppleAppSpec)"
        push l ("        s.name = \"" + className + "\"")
        push l ("        s.displayName = \"" + projectName + "\"")
        push l ("        s.bundleId = \"" + bundleId + "\"")
        push l "        s.version = \"0.1.0\""
        push l "        s.build = \"1\""
        push l "        ; The host shell first, then the generated Ranger module: swiftc takes"
        push l "        ; the whole module at once, so the order is for people reading it."
        push l "        s.addSource(\"platforms/ios/App.swift\")"
        push l ("        s.addSource(\"build/ios/" + className + ".swift\")")
        push l "        return s"
        push l "    }"
        push l ""
        push l "    sfn m@(main):void () {"
        push l "        def dry:boolean false"
        push l "        def cnt:int (shell_arg_cnt)"
        push l "        def i:int 0"
        push l "        while (i < cnt) {"
        push l "            if ((shell_arg i) == \"--dry-run\") {"
        push l "                dry = true"
        push l "            }"
        push l "            i = i + 1"
        push l "        }"
        push l ""
        push l "        def sh:Shell (new Shell)"
        push l "        sh.dryRun = dry"
        push l "        def tools:AppleToolchain (new AppleToolchain (sh))"
        push l "        def builder:AppleAppBuilder (new AppleAppBuilder (sh tools))"
        push l "        builder.buildRoot = \"build\""
        push l ""
        push l "        def target:AppleTarget (AppleTarget.iosSimulator(\"arm64\"))"
        push l "        def appSpec:AppleAppSpec (IosBuild.spec())"
        push l ""
        push l "        ; The device families this project configured, as UIDeviceFamily."
        push l "        def families:[int]"
        for families family:string fi {
            push l ("        push families " + family)
        }
        push l "        target.families = families"
        push l ""
        push l "        def res:AppleBuildResult (builder.build(appSpec target))"
        push l ""
        push l "        if dry {"
        push l "            print \"-- the build this would run --\""
        push l "            for sh.commands line:string j {"
        push l "                print (\"   \" + line)"
        push l "            }"
        push l "        }"
        push l "        if (res.ok == false) {"
        push l "            print (\"ios-build: \" + res.message)"
        push l "            exit 1"
        push l "        }"
        push l "        print (\"ios-build: \" + res.appPath)"
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; A shared module for a mobile surface: exported classes, and no `main`. The
    ; host shell calls it.
    sfn mobileSeed:string (projectName:string className:string) {
        def l:[string]
        push l "; SPDX-License-Identifier: MIT"
        push l ";"
        push l ("; " + projectName + " -- the shared application module.")
        push l ";"
        push l "; ONE source, compiled to Kotlin for Android and to Swift for iOS. The host"
        push l "; shell on each platform owns the lifecycle and the UI; this owns what the app"
        push l "; KNOWS, and neither platform has its own copy of it."
        push l ";"
        push l "; There is deliberately no `main`: the platform calls the shell, and the shell"
        push l "; calls this."
        push l ";"
        push l "; This file was written once and is yours now; nothing regenerates it."
        push l ""
        push l ("class " + className + " {")
        push l ""
        push l "    Constructor () {"
        push l "    }"
        push l ""
        push l "    fn greeting:string () {"
        push l ("        return \"hello from " + projectName + ", compiled from Ranger\"")
        push l "    }"
        push l "}"
        return ((StarterText.joinWith(l "\n")) + "\n")
    }

    ; The extra lines are what the enabled profiles asked to ignore -- the web
    ; surface compiles into its Vite root, which is inside the tree rather than
    ; under `build/`.
    sfn gitignore:string (extra:[string]) {
        def l:[string]
        push l "# Generated by ranger-starter. Your own entries are kept: this file is only"
        push l "# rewritten while it is byte-identical to what was generated."
        push l ""
        push l "node_modules/"
        push l "build/"
        push l "vendor/"
        push l "ranger.lock"
        push l ".DS_Store"
        for (StarterText.sorted(extra)) path:string i {
            push l path
        }
        return ((StarterText.joinWith(l "\n")) + "\n")
    }
}
