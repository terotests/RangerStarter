; SPDX-License-Identifier: MIT
;
; StarterJson -- a JSON value, a parser and a writer, in portable Ranger.
;
; WHY THIS EXISTS, given that `lib/JSON.rgr` already maps JSON onto each
; target's native object type. Two reasons, and both are requirements of the
; generator rather than preferences:
;
;   1. KEY ORDER. A Go map does not have one. This file keeps an explicit order
;      array, so a `package.json` read and written back is byte-identical on
;      every target -- which is what makes "running setup twice changes nothing"
;      checkable with `git diff --exit-code` rather than by eye.
;
;   2. UNKNOWN KEYS SURVIVE. Merging into somebody's existing `package.json`
;      means keeping every key this program has never heard of, in place. A tree
;      that holds what it read does that; a mapping onto declared fields does
;      not.
;
; It is also why the starter core has no dependencies at all: `npm install` and
; it compiles, on all fourteen targets.
;
; Strings are built by concatenation and RETURNED, never appended into a
; parameter. `str_append` mutates in place, and a string is a value on most of
; the fourteen targets, so a builder threaded through a parameter is a portability
; bug waiting for the first Go run. `lib/evg/EVGTreeJson.rgr` writes JSON the
; same way for the same reason.

; One JSON value. The kind is a string rather than an enum because it is written
; into error messages and golden files as often as it is switched on.
class JsonValue {

    ; "object" | "array" | "string" | "number" | "bool" | "null"
    def kind:string "null"

    def text:string ""
    def num:double 0.0
    def ival:int 0
    def isInt:boolean false
    def flag:boolean false

    ; An object, as the order it was read in plus the values. Both are needed:
    ; `entries` answers a lookup, `order` answers "what did the file look like".
    def order:[string]
    def entries:[string:JsonValue]

    def items:[JsonValue]

    Constructor () {
    }

    sfn newObject:JsonValue () {
        def v (new JsonValue())
        v.kind = "object"
        return v
    }

    sfn newArray:JsonValue () {
        def v (new JsonValue())
        v.kind = "array"
        return v
    }

    sfn newNull:JsonValue () {
        def v (new JsonValue())
        v.kind = "null"
        return v
    }

    sfn fromText:JsonValue (s:string) {
        def v (new JsonValue())
        v.kind = "string"
        v.text = s
        return v
    }

    sfn fromInt:JsonValue (i:int) {
        def v (new JsonValue())
        v.kind = "number"
        v.ival = i
        v.isInt = true
        return v
    }

    sfn fromBool:JsonValue (b:boolean) {
        def v (new JsonValue())
        v.kind = "bool"
        v.flag = b
        return v
    }

    ; A string array, which is most of what the configuration holds.
    sfn fromStrings:JsonValue (list:[string]) {
        def v:JsonValue (JsonValue.newArray())
        for list s:string i {
            v.addItem((JsonValue.fromText(s)))
        }
        return v
    }

    fn isObject:boolean () {
        return (kind == "object")
    }

    fn isArray:boolean () {
        return (kind == "array")
    }

    fn isNull:boolean () {
        return (kind == "null")
    }

    ; --- objects --------------------------------------------------------------

    fn hasKey:boolean (key:string) {
        return (has entries key)
    }

    ; Set a key, appending it to the order the first time it is seen. Setting an
    ; existing key keeps its position, which is the whole point of `order`.
    fn putKey:void (key:string value:JsonValue) {
        if (has entries key) {
            set entries key value
            return
        }
        push order key
        set entries key value
    }

    fn getKey@(optional):JsonValue (key:string) {
        return (get entries key)
    }

    ; There is no operator that removes a key from a map, so the map is rebuilt
    ; from the surviving order. An object in a configuration file has tens of
    ; keys, not thousands.
    fn dropKey:void (key:string) {
        if ((has entries key) == false) {
            return
        }
        def keptOrder:[string]
        def keptEntries:[string:JsonValue]
        for order k:string i {
            if (k != key) {
                def hit@(optional):JsonValue (get entries k)
                if (null? hit) {
                    continue
                }
                push keptOrder k
                set keptEntries k (unwrap hit)
            }
        }
        order = keptOrder
        entries = keptEntries
    }

    ; --- reads with a fallback ------------------------------------------------
    ;
    ; A configuration read must never throw on a file somebody typed by hand, so
    ; every read answers the fallback when the key is absent or the wrong kind,
    ; and validation -- not parsing -- reports that as a problem.

    fn getText:string (key:string fallback:string) {
        def hit@(optional):JsonValue (get entries key)
        if (null? hit) {
            return fallback
        }
        def v:JsonValue (unwrap hit)
        if (v.kind != "string") {
            return fallback
        }
        return v.text
    }

    fn getBool:boolean (key:string fallback:boolean) {
        def hit@(optional):JsonValue (get entries key)
        if (null? hit) {
            return fallback
        }
        def v:JsonValue (unwrap hit)
        if (v.kind != "bool") {
            return fallback
        }
        return v.flag
    }

    fn getInt:int (key:string fallback:int) {
        def hit@(optional):JsonValue (get entries key)
        if (null? hit) {
            return fallback
        }
        def v:JsonValue (unwrap hit)
        if (v.kind != "number") {
            return fallback
        }
        return v.ival
    }

    ; An absent object reads as an empty one, so a caller can walk into
    ; `surfaces.android.devices` without four null checks.
    fn getObject:JsonValue (key:string) {
        def hit@(optional):JsonValue (get entries key)
        if (null? hit) {
            return (JsonValue.newObject())
        }
        def v:JsonValue (unwrap hit)
        if (v.kind != "object") {
            return (JsonValue.newObject())
        }
        return v
    }

    fn getArray:JsonValue (key:string) {
        def hit@(optional):JsonValue (get entries key)
        if (null? hit) {
            return (JsonValue.newArray())
        }
        def v:JsonValue (unwrap hit)
        if (v.kind != "array") {
            return (JsonValue.newArray())
        }
        return v
    }

    ; The array at `key` as plain strings, skipping anything that is not one.
    fn getStrings:[string] (key:string) {
        def out:[string]
        def a:JsonValue (this.getArray(key))
        for a.items item:JsonValue i {
            if (item.kind == "string") {
                push out item.text
            }
        }
        return out
    }

    ; --- arrays ---------------------------------------------------------------

    fn addItem:void (value:JsonValue) {
        push items value
    }

    fn itemCount:int () {
        return (array_length items)
    }

    ; --- writing --------------------------------------------------------------

    ; Two spaces, keys in the order they were set, and a trailing newline: the
    ; shape npm itself writes, so a merged `package.json` is not a whole-file
    ; diff.
    fn asText:string () {
        def body:string (this.textAt(0))
        return (body + "\n")
    }

    fn textAt:string (depth:int) {
        switch kind {
            case "object" {
                return (this.objectTextAt(depth))
            }
            case "array" {
                return (this.arrayTextAt(depth))
            }
            case "string" {
                return (StarterJson.quote(text))
            }
            case "number" {
                ; `to_string` on a double prints 7 on JavaScript and Go and 7.0
                ; on Python. A schema version reading `1` in one generated file
                ; and `1.0` in another is a diff, so an integer always goes
                ; through the integer path.
                if isInt {
                    return (to_string ival)
                }
                return (to_string num)
            }
            case "bool" {
                if flag {
                    return "true"
                }
                return "false"
            }
        }
        return "null"
    }

    fn objectTextAt:string (depth:int) {
        def cnt:int (array_length order)
        if (cnt == 0) {
            return "{}"
        }
        def pad:string (StarterJson.indent((depth + 1)))
        def out:string "{\n"
        def i:int 0
        while (i < cnt) {
            def key:string (itemAt order i)
            out = out + pad + (StarterJson.quote(key)) + ": "
            def hit@(optional):JsonValue (get entries key)
            if (null? hit) {
                out = out + "null"
            } {
                def child:JsonValue (unwrap hit)
                out = out + (child.textAt((depth + 1)))
            }
            if (i < (cnt - 1)) {
                out = out + ","
            }
            out = out + "\n"
            i = i + 1
        }
        return (out + (StarterJson.indent(depth)) + "}")
    }

    fn arrayTextAt:string (depth:int) {
        def cnt:int (array_length items)
        if (cnt == 0) {
            return "[]"
        }
        def pad:string (StarterJson.indent((depth + 1)))
        def out:string "[\n"
        def i:int 0
        while (i < cnt) {
            def item:JsonValue (itemAt items i)
            out = out + pad + (item.textAt((depth + 1)))
            if (i < (cnt - 1)) {
                out = out + ","
            }
            out = out + "\n"
            i = i + 1
        }
        return (out + (StarterJson.indent(depth)) + "]")
    }
}

; The parser, and the two text helpers the writer needs. A class rather than
; free functions because a parse carries a position.
class StarterJson {

    def src:string ""
    def pos:int 0
    def len:int 0

    ; Empty when the parse succeeded. A parse never throws: a hand-edited
    ; configuration with a trailing comma is an error message, not a crash.
    def problem:string ""

    Constructor () {
    }

    sfn indent:string (depth:int) {
        def out:string ""
        def i:int 0
        while (i < depth) {
            out = out + "  "
            i = i + 1
        }
        return out
    }

    sfn quote:string (s:string) {
        def out:string "\""
        def cnt:int (strlen s)
        def i:int 0
        while (i < cnt) {
            def c:int (charAt s i)
            if (c == 34) {
                out = out + "\\\""
            } {
                if (c == 92) {
                    out = out + "\\\\"
                } {
                    if (c == 10) {
                        out = out + "\\n"
                    } {
                        if (c == 13) {
                            out = out + "\\r"
                        } {
                            if (c == 9) {
                                out = out + "\\t"
                            } {
                                if (c < 32) {
                                    out = out + (StarterJson.unicodeEscape(c))
                                } {
                                    out = out + (substring s i (i + 1))
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
        return (out + "\"")
    }

    sfn unicodeEscape:string (c:int) {
        def digits:string "0123456789abcdef"
        def hi:int (idiv c 16)
        def lo:int (c - (hi * 16))
        def out:string "\\u00"
        out = out + (substring digits hi (hi + 1))
        out = out + (substring digits lo (lo + 1))
        return out
    }

    ; Parse `theText`. Answers a null value and sets `problem` when it cannot.
    fn parse:JsonValue (theText:string) {
        src = theText
        pos = 0
        len = (strlen theText)
        problem = ""
        this.skipWs()
        def v:JsonValue (this.parseValue())
        if ((strlen problem) > 0) {
            return (JsonValue.newNull())
        }
        this.skipWs()
        if (pos < len) {
            problem = ("unexpected text at offset " + (to_string pos))
            return (JsonValue.newNull())
        }
        return v
    }

    fn ok:boolean () {
        return ((strlen problem) == 0)
    }

    fn peek:int () {
        if (pos >= len) {
            return 0
        }
        return (charAt src pos)
    }

    fn skipWs:void () {
        while (pos < len) {
            def c:int (charAt src pos)
            if (c == 32) {
                pos = pos + 1
                continue
            }
            if (c == 9) {
                pos = pos + 1
                continue
            }
            if (c == 10) {
                pos = pos + 1
                continue
            }
            if (c == 13) {
                pos = pos + 1
                continue
            }
            return
        }
    }

    fn fail:JsonValue (why:string) {
        if ((strlen problem) == 0) {
            problem = why + " at offset " + (to_string pos)
        }
        return (JsonValue.newNull())
    }

    fn parseValue:JsonValue () {
        if (pos >= len) {
            return (this.fail("unexpected end of input"))
        }
        def c:int (this.peek())
        if (c == 123) {
            return (this.parseObject())
        }
        if (c == 91) {
            return (this.parseArray())
        }
        if (c == 34) {
            def s:string (this.parseString())
            if ((this.ok()) == false) {
                return (JsonValue.newNull())
            }
            return (JsonValue.fromText(s))
        }
        if (c == 116) {
            return (this.parseWord("true"))
        }
        if (c == 102) {
            return (this.parseWord("false"))
        }
        if (c == 110) {
            return (this.parseWord("null"))
        }
        return (this.parseNumber())
    }

    fn parseWord:JsonValue (word:string) {
        def n:int (strlen word)
        if ((pos + n) > len) {
            return (this.fail(("expected " + word)))
        }
        def got:string (substring src pos (pos + n))
        if (got != word) {
            return (this.fail(("expected " + word)))
        }
        pos = pos + n
        if (word == "true") {
            return (JsonValue.fromBool(true))
        }
        if (word == "false") {
            return (JsonValue.fromBool(false))
        }
        return (JsonValue.newNull())
    }

    fn parseObject:JsonValue () {
        def v:JsonValue (JsonValue.newObject())
        pos = pos + 1
        this.skipWs()
        if ((this.peek()) == 125) {
            pos = pos + 1
            return v
        }
        def running:boolean true
        while running {
            this.skipWs()
            if ((this.peek()) != 34) {
                return (this.fail("expected a key"))
            }
            def key:string (this.parseString())
            if ((this.ok()) == false) {
                return (JsonValue.newNull())
            }
            this.skipWs()
            if ((this.peek()) != 58) {
                return (this.fail("expected `:`"))
            }
            pos = pos + 1
            this.skipWs()
            def child:JsonValue (this.parseValue())
            if ((this.ok()) == false) {
                return (JsonValue.newNull())
            }
            v.putKey(key child)
            this.skipWs()
            def c:int (this.peek())
            if (c == 44) {
                pos = pos + 1
                this.skipWs()
                ; A trailing comma is the commonest hand-edit mistake, so it
                ; gets its own message rather than "expected a key".
                if ((this.peek()) == 125) {
                    return (this.fail("trailing comma in an object"))
                }
            } {
                if (c == 125) {
                    pos = pos + 1
                    running = false
                } {
                    return (this.fail("expected `,` or `}`"))
                }
            }
        }
        return v
    }

    fn parseArray:JsonValue () {
        def v:JsonValue (JsonValue.newArray())
        pos = pos + 1
        this.skipWs()
        if ((this.peek()) == 93) {
            pos = pos + 1
            return v
        }
        def running:boolean true
        while running {
            this.skipWs()
            def child:JsonValue (this.parseValue())
            if ((this.ok()) == false) {
                return (JsonValue.newNull())
            }
            v.addItem(child)
            this.skipWs()
            def c:int (this.peek())
            if (c == 44) {
                pos = pos + 1
                this.skipWs()
                if ((this.peek()) == 93) {
                    return (this.fail("trailing comma in an array"))
                }
            } {
                if (c == 93) {
                    pos = pos + 1
                    running = false
                } {
                    return (this.fail("expected `,` or `]`"))
                }
            }
        }
        return v
    }

    fn parseString:string () {
        pos = pos + 1
        def out:string ""
        while (pos < len) {
            def c:int (charAt src pos)
            if (c == 34) {
                pos = pos + 1
                return out
            }
            if (c == 92) {
                pos = pos + 1
                if (pos >= len) {
                    problem = "unterminated escape"
                    return out
                }
                def e:int (charAt src pos)
                pos = pos + 1
                out = out + (this.unescape(e))
            } {
                out = out + (substring src pos (pos + 1))
                pos = pos + 1
            }
        }
        problem = "unterminated string"
        return out
    }

    fn unescape:string (e:int) {
        if (e == 110) {
            return "\n"
        }
        if (e == 116) {
            return "\t"
        }
        if (e == 114) {
            return "\r"
        }
        if (e == 98) {
            return "\b"
        }
        if (e == 102) {
            return "\f"
        }
        if (e == 117) {
            return (this.readUnicode())
        }
        return (strfromcode e)
    }

    ; `\uXXXX`, with a surrogate pair joined into one codepoint so a name outside
    ; the basic plane survives a read and a write.
    fn readUnicode:string () {
        def hi:int (this.readHex4())
        if ((this.ok()) == false) {
            return ""
        }
        if (hi < 55296) {
            return (strfromcode hi)
        }
        if (hi > 56319) {
            return (strfromcode hi)
        }
        if ((pos + 1) >= len) {
            return (strfromcode hi)
        }
        if ((charAt src pos) != 92) {
            return (strfromcode hi)
        }
        if ((charAt src (pos + 1)) != 117) {
            return (strfromcode hi)
        }
        pos = pos + 2
        def lo:int (this.readHex4())
        if ((this.ok()) == false) {
            return ""
        }
        def cp:int (65536 + (((hi - 55296) * 1024) + (lo - 56320)))
        return (strfromcode cp)
    }

    fn readHex4:int () {
        if ((pos + 4) > len) {
            problem = "truncated \\u escape"
            return 0
        }
        def value:int 0
        def i:int 0
        while (i < 4) {
            def c:int (charAt src (pos + i))
            def digit:int (StarterJson.hexDigit(c))
            if (digit < 0) {
                problem = "bad hex digit in a \\u escape"
                return 0
            }
            value = (value * 16) + digit
            i = i + 1
        }
        pos = pos + 4
        return value
    }

    sfn hexDigit:int (c:int) {
        if (c >= 48) {
            if (c <= 57) {
                return (c - 48)
            }
        }
        if (c >= 97) {
            if (c <= 102) {
                return ((c - 97) + 10)
            }
        }
        if (c >= 65) {
            if (c <= 70) {
                return ((c - 65) + 10)
            }
        }
        return -1
    }

    fn parseNumber:JsonValue () {
        def start:int pos
        def looksInt:boolean true
        if ((this.peek()) == 45) {
            pos = pos + 1
        }
        def scanning:boolean true
        while scanning {
            if (pos >= len) {
                scanning = false
            } {
                def c:int (charAt src pos)
                if (StarterJson.isDigit(c)) {
                    pos = pos + 1
                } {
                    if (StarterJson.isNumberPunct(c)) {
                        if (c != 43) {
                            looksInt = false
                        }
                        pos = pos + 1
                    } {
                        scanning = false
                    }
                }
            }
        }
        if (pos == start) {
            return (this.fail("expected a value"))
        }
        ; No trailing space can reach `to_double` here, which matters: Go's parse
        ; refuses `"10 "` where JavaScript and Python accept it.
        def digits:string (substring src start pos)
        def asDouble@(optional):double (to_double digits)
        if (null? asDouble) {
            return (this.fail(("`" + digits + "` is not a number")))
        }
        def v (new JsonValue())
        v.kind = "number"
        v.num = (unwrap asDouble)
        v.isInt = looksInt
        if looksInt {
            def asInt@(optional):int (to_int digits)
            if (null? asInt) {
                v.isInt = false
            } {
                v.ival = (unwrap asInt)
            }
        } {
            v.ival = (to_int v.num)
        }
        return v
    }

    sfn isDigit:boolean (c:int) {
        if (c < 48) {
            return false
        }
        if (c > 57) {
            return false
        }
        return true
    }

    ; `.`, `e`, `E`, `+`, `-` -- everything a JSON number may carry that is not a
    ; digit. `+` alone does not make a number fractional; the others do.
    sfn isNumberPunct:boolean (c:int) {
        if (c == 46) {
            return true
        }
        if (c == 101) {
            return true
        }
        if (c == 69) {
            return true
        }
        if (c == 43) {
            return true
        }
        if (c == 45) {
            return true
        }
        return false
    }
}
