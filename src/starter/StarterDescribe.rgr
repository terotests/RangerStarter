; SPDX-License-Identifier: MIT
;
; StarterDescribe -- `ranger-starter describe --json`: everything an agent needs
; to drive this tool, in one call.
;
; WHY IT EXISTS. An agent that wants to configure a project otherwise has to
; discover, by reading prose: which commands there are, which flags each takes,
; which surfaces this BUILD can actually generate (as opposed to which ones the
; configuration file has slots for), which targets the installed compiler has,
; and what a valid `ranger.project.json` looks like. Four of those five change
; between versions and the fifth changes with the compiler.
;
; So it is answered as data, from the same registries the tool itself reads --
; the profile registry and the target table -- rather than from a hand-kept list
; that would drift. A surface that appears here is a surface that will generate;
; one marked `available: false` is one `apply` would refuse, and it says which
; milestone brings it.
;
; It is pure: it takes the registries and answers a `JsonValue`.

Import "StarterProfiles.rgr"
Import "StarterConfig.rgr"
Import "StarterTargets.rgr"

class StarterDescribe {

    Constructor () {
    }

    sfn describe:JsonValue (profiles:StarterProfiles targets:StarterTargets assetSkills:[string]) {
        def root:JsonValue (JsonValue.newObject())
        root.putKey("schema" (JsonValue.fromInt(1)))
        root.putKey("tool" (JsonValue.fromText("ranger-starter")))
        root.putKey("configFile" (JsonValue.fromText("ranger.project.json")))
        root.putKey("configSchema" (JsonValue.fromInt(1)))

        def note:string "ranger.project.json is the source of truth. Edit it and run `plan` then `apply`; there is no questionnaire to answer. Every command exits 0 on success, 1 on a problem with the project, 2 on a problem with the command line."
        root.putKey("note" (JsonValue.fromText(note)))

        root.putKey("commands" (StarterDescribe.commands()))
        root.putKey("surfaces" (StarterDescribe.surfaces(profiles)))
        root.putKey("targets" (StarterDescribe.targets(targets)))
        root.putKey("skills" (JsonValue.fromStrings(assetSkills)))
        root.putKey("example" (StarterDescribe.example()))
        return root
    }

    sfn command:JsonValue (name:string summary:string flags:[string]) {
        def c:JsonValue (JsonValue.newObject())
        c.putKey("name" (JsonValue.fromText(name)))
        c.putKey("summary" (JsonValue.fromText(summary)))
        c.putKey("flags" (JsonValue.fromStrings(flags)))
        return c
    }

    sfn commands:JsonValue () {
        def out:JsonValue (JsonValue.newArray())

        def common:[string]
        push common "--config <path>"
        push common "--json"

        def initFlags:[string]
        push initFlags "--name <name>"
        push initFlags "--kind application|library"
        push initFlags "--surfaces <a,b>"
        push initFlags "--targets <t1,t2>"
        push initFlags "--devices <d1,d2>"
        push initFlags "--docs"
        push initFlags "--strict-docs"
        push initFlags "--agents generic|claude|both"
        push initFlags "--apply"
        push initFlags "--no-install"
        push initFlags "--config <path>"
        push initFlags "--json"
        out.addItem((StarterDescribe.command("init" "Write a configuration from flags. Every surface is listed and switched off unless --surfaces names it. With --apply, generates immediately." initFlags)))

        def applyFlags:[string]
        push applyFlags "--no-install"
        push applyFlags "--dry-run"
        push applyFlags "--config <path>"
        push applyFlags "--json"
        out.addItem((StarterDescribe.command("plan" "What apply would do. Writes nothing. With --json, the action list as data -- the same value apply performs." common)))
        out.addItem((StarterDescribe.command("apply" "Generate the project. Idempotent: running it again changes nothing." applyFlags)))
        out.addItem((StarterDescribe.command("doctor" "Whether this machine can build what is configured. Exits 1 when something actionable is missing." common)))
        out.addItem((StarterDescribe.command("targets" "The targets the installed compiler supports." common)))
        out.addItem((StarterDescribe.command("describe" "This: the commands, surfaces, targets and skills, as data." common)))

        def configureFlags:[string]
        push configureFlags "--apply"
        push configureFlags "--config <path>"
        out.addItem((StarterDescribe.command("configure" "The interactive questionnaire. NEEDS A TERMINAL -- it refuses a pipe and tells you to use init/plan/apply instead. With --apply it skips the questions and generates from the existing configuration." configureFlags)))
        return out
    }

    ; Every surface the CONFIGURATION knows, with whether this build can generate
    ; it. Listing only the available ones would hide the plan; listing them all
    ; without the flag would invite a configuration that `apply` refuses.
    sfn surfaces:JsonValue (profiles:StarterProfiles) {
        def out:JsonValue (JsonValue.newArray())
        def ids:[string] (StarterConfig.surfaceIds())
        for ids sid:string i {
            def entry:JsonValue (JsonValue.newObject())
            entry.putKey("id" (JsonValue.fromText(sid)))
            entry.putKey("title" (JsonValue.fromText((StarterConfig.surfaceTitle(sid)))))
            entry.putKey("multiTarget" (JsonValue.fromBool((StarterConfig.isMultiTarget(sid)))))
            def hit@(optional):StarterProfile (profiles.find(sid))
            if (null? hit) {
                entry.putKey("available" (JsonValue.fromBool(false)))
                entry.putKey("why" (JsonValue.fromText((StarterDescribe.notYet(sid)))))
            } {
                def p:StarterProfile (unwrap hit)
                entry.putKey("available" (JsonValue.fromBool(true)))
                entry.putKey("defaultTarget" (JsonValue.fromText((p.defaultTarget()))))
                def allowed:[string] (p.targetsAllowed())
                if ((array_length allowed) > 0) {
                    entry.putKey("targetsAllowed" (JsonValue.fromStrings(allowed)))
                }
            }
            out.addItem(entry)
        }
        return out
    }

    sfn notYet:string (sid:string) {
        switch sid {
            case "server" {
                return "not implemented yet: an HTTP service (PLAN_STARTER.md M8)"
            }
            case "desktop" {
                return "not implemented yet: SDL2 through C++ (PLAN_STARTER.md M9)"
            }
            case "android" {
                return "not implemented yet: a Kotlin module in a Compose shell (PLAN_STARTER.md M10)"
            }
            case "ios" {
                return "not implemented yet: a Swift module over lib/apple (PLAN_STARTER.md M11)"
            }
        }
        return "not implemented yet"
    }

    sfn targets:JsonValue (targets:StarterTargets) {
        def out:JsonValue (JsonValue.newObject())
        out.putKey("source" (JsonValue.fromText(targets.source)))
        if (targets.source == "bundled") {
            out.putKey("note" (JsonValue.fromText("the installed compiler does not answer `rgrc -targets -json`, so this is the table bundled with ranger-starter")))
        }
        def list:JsonValue (JsonValue.newArray())
        for targets.list t:StarterTarget i {
            def entry:JsonValue (JsonValue.newObject())
            entry.putKey("id" (JsonValue.fromText(t.id)))
            entry.putKey("name" (JsonValue.fromText(t.name)))
            entry.putKey("tier" (JsonValue.fromText(t.tier)))
            entry.putKey("ext" (JsonValue.fromText(t.ext)))
            if ((strlen t.packaging) > 0) {
                entry.putKey("packaging" (JsonValue.fromText(t.packaging)))
            }
            if (t.isVariant()) {
                ; Not a `-l=` value. An agent that writes it into a build command
                ; gets "Invalid language : typescript".
                entry.putKey("variantOf" (JsonValue.fromText(t.variantOf)))
            }
            entry.putKey("runsLocally" (JsonValue.fromBool(t.runsLocally)))
            list.addItem(entry)
        }
        out.putKey("list" list)
        return out
    }

    ; A configuration that works, so an agent has something to copy rather than
    ; assemble from the schema.
    sfn example:JsonValue () {
        def cfg:StarterConfig (StarterConfig.defaults("northwind" "application"))
        cfg.setEnabled("cli" true)
        def ts:[string]
        push ts "es6"
        push ts "go"
        cfg.setTargets("cli" ts)
        cfg.setDocs(true true false)
        cfg.setAgents(true true "auto")
        return cfg.root
    }
}
